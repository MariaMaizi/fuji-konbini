# Copy this file to server/.env.bailian and fill the key locally.
# Never put a key in web/ or in a commit.
CLERK_PROVIDER=bailian
DASHSCOPE_API_KEY=
BAILIAN_MODEL=qwen3.6-plus
CLERK_REPLY_MODE=direct
# No automatic fallback model is configured.
BAILIAN_FALLBACK_MODEL=
# Optional existing local HTTP proxy; leave blank for direct access.
CLERK_HTTPS_PROXY=
